{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level = local development only (ADR-010). The name says so, and a bare `wrangler deploy`
  // gets no public URL because workers_dev and preview_urls are off here.
  "name": "stack-cloudflare-local-do-not-deploy",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  // Pinned. Update on purpose, in a reviewed change (spec: platform/cloudflare.md rule 17).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },

  // Local development uses these top-level bindings. They are NOT a production environment.
  // Production is not defined yet (ADR-008). Do not run a bare `wrangler deploy`. Miniflare simulates them in workerd.
  // The database_id is a placeholder. Local mode does not need a real ID.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stack-cloudflare-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "stack-cloudflare-artifacts" }],
  "queues": {
    "producers": [{ "binding": "EVALUATION_QUEUE", "queue": "stack-cloudflare-evaluations" }],
    "consumers": [
      {
        "queue": "stack-cloudflare-evaluations",
        "max_retries": 3,
        "dead_letter_queue": "stack-cloudflare-evaluations-dlq",
      },
      // ADR-010: the dead-letter consumer marks the submission failed.
      { "queue": "stack-cloudflare-evaluations-dlq", "max_retries": 3 },
    ],
  },
  "workflows": [
    {
      "binding": "PUBLICATION_WORKFLOW",
      "name": "stack-cloudflare-publication",
      "class_name": "PublicationWorkflow",
    },
  ],

  "env": {
    // Staging is a deployed environment. Replace the placeholder IDs before the first deploy.
    // Bindings are not inherited by environments, so each environment declares all bindings.
    "staging": {
      "name": "stack-cloudflare-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stack-cloudflare-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_UUID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "stack-cloudflare-artifacts-staging" }],
      "queues": {
        "producers": [{ "binding": "EVALUATION_QUEUE", "queue": "stack-cloudflare-evaluations-staging" }],
        "consumers": [
          {
            "queue": "stack-cloudflare-evaluations-staging",
            "max_retries": 3,
            "dead_letter_queue": "stack-cloudflare-evaluations-staging-dlq",
          },
          { "queue": "stack-cloudflare-evaluations-staging-dlq", "max_retries": 3 },
        ],
      },
      "workflows": [
        {
          "binding": "PUBLICATION_WORKFLOW",
          "name": "stack-cloudflare-publication-staging",
          "class_name": "PublicationWorkflow",
        },
      ],
    },
  },
}
